// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================
// Schedule analytics domain models
// =====================================================

/// A teacher / educator. The id is the source-system `EducatorMasterId`
/// (the same educator id is used across all time periods). The full staff
/// roster comes from the HR export (upload/staff, scripts/import-staff.ts);
/// educators without a timetable appear in the staff list only.
/// `topLevelUnitId` — подразделение первого уровня из файла текущих
/// сотрудников (upload/employees.json, scripts/import-employees.ts);
/// null = нет записи в файле или ФИО не разрешено однозначно.
model Educator {
  id          Int    @id
  displayName String
  longName    String

  topLevelUnitId Int?
  topLevelUnit   TopLevelUnit? @relation(fields: [topLevelUnitId], references: [id])

  events           ScheduleEvent[]          @relation("PrimaryEducatorEvents")
  employments      Employment[]
  employeeMatches  EmployeeMatch[]

  @@index([topLevelUnitId])
}

/// Подразделение первого уровня (институт / факультет).
model TopLevelUnit {
  id    Int    @id @default(autoincrement())
  name  String @unique

  educators Educator[]

  @@index([name])
}

/// Сопоставление записи из upload/employees.json (стабильный id кадровой
/// системы) с преподавателем, установленное скриптом import-employees.ts
/// по ФИО + пересечению должностей. score — вес совпадения должностей.
model EmployeeMatch {
  fileId     String   @id
  educatorId Int
  educator   Educator @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  score      Int

  @@index([educatorId])
}

/// Должность преподавателя (Position) в подразделении (Department) —
/// одна строка кадровой выгрузки. У преподавателя может быть несколько
/// должностей. departmentId NULL — подразделение в выгрузке не указано.
model Employment {
  id           Int    @id @default(autoincrement())
  educatorId   Int
  educator     Educator @relation(fields: [educatorId], references: [id], onDelete: Cascade)
  position     String
  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id])

  @@unique([educatorId, position, departmentId])
  @@index([educatorId])
  @@index([position])
  @@index([departmentId])
}

/// Подразделение (кафедра, факультет, …) из кадровой выгрузки —
/// справочник для фильтра преподавателей по подразделению.
model Department {
  id          Int    @id @default(autoincrement())
  name        String @unique

  employments Employment[]

  @@index([name])
}

/// A physical address ("<Улица>, д. <дом>") parsed from the location display
/// name at import time. Several locations (auditoriums) share one address.
model Address {
  id          Int    @id @default(autoincrement())
  displayName String @unique

  locations Location[]

  @@index([displayName])
}

/// A classroom / physical location. Unique by `displayName`.
/// `displayName` keeps the full source text:
/// "<Улица>, д. <дом>[, лит. X][, пом. Y], <номер аудитории>".
model Location {
  id          Int    @id @default(autoincrement())
  displayName String @unique
  latitude    Float?
  longitude   Float?

  // Parsed address part ("<Улица>, д. <дом>"); null for virtual locations
  // without an address (e.g. "по месту проведения практики").
  addressId Int?
  address   Address? @relation(fields: [addressId], references: [id])

  events        ScheduleEventLocation[]
  primaryEvents ScheduleEvent[]         @relation("PrimaryLocation")

  @@index([displayName])
  @@index([addressId])
}

/// A subject. Unique by name.
model Subject {
  id     Int    @id @default(autoincrement())
  name   String @unique
  events ScheduleEvent[]

  @@index([name])
}

/// A student group / contingent unit. Unique by name.
model Group {
  id    Int    @id @default(autoincrement())
  name  String @unique
  events ScheduleEventGroup[]

  @@index([name])
}

/// A schedule term period (two per year), imported from the schedule file:
/// `DateRangeDisplayText` + the period bounds from the file's From/To.
model DateRange {
  id          Int      @id @default(autoincrement())
  displayText String   @unique
  dateFrom    DateTime
  dateTo      DateTime

  events ScheduleEvent[]

  @@index([dateFrom, dateTo])
}

/// A lesson form (лекция, экзамен, зачёт, …) parsed from the tail of the
/// event's Subject text after the last comma. See scripts/lesson-forms.ts.
model LessonForm {
  id     Int    @id @default(autoincrement())
  name   String @unique

  events ScheduleEvent[]

  @@index([name])
}

/// A single schedule session (one teacher + one time slot).
/// The same physical lecture delivered by several teachers appears as one row per teacher.
/// Rows belonging to the same physical lecture share `globalEventHash`.
model ScheduleEvent {
  id        String @id @default(cuid())
  educatorId Int
  educator  Educator @relation("PrimaryEducatorEvents", fields: [educatorId], references: [id])
  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id])

  // Date / time fields (UTC instants)
  startDateTime   DateTime
  endDateTime     DateTime
  rawStart        String   // "11:00:00"
  rawEnd          String?  // "12:30:00" — null/empty when not specified
  hasInferredEnd  Boolean  @default(false) // true when End was missing and we used +90min
  durationMinutes Int

  // Day-of-week label as in the source file (1=Mon…7=Sun)
  dayOfWeek Int
  dayString String
  dateStr   String // original Dates string e.g. "2.6" or "с 17.2 по 19.5 (14)"

  // Schedule term info
  termFrom     DateTime
  termTo       DateTime
  isSpringTerm Boolean

  // Misc
  isCanceled           Boolean @default(false)
  kindCode             Int     @default(0)
  educatorsDisplayText String

  // Groups events of the same teacher that overlap in time.
  // Events in the same group are "simultaneous" — the teacher is in fact in one place
  // delivering several listed classes at once.
  simultaneousGroupId String?

  // Identifies the same physical lecture across multiple teacher JSON files
  // (used to dedupe room utilization and counts of unique lectures).
  // Includes subject + start + end + sorted locations + sorted educators.
  // EXCLUDES groups: the same physical lecture delivered to multiple groups
  // produces multiple rows (one per group) all sharing this `globalEventHash`.
  globalEventHash String

  // Identifies the same physical lecture IGNORING the audience — used to
  // dedupe room utilization (one physical lecture = one utilization slot).
  lectureHash String

  // Denormalized PRIMARY location (the first of the event's locations, by
  // ascending locationId). Room analytics read this column directly instead
  // of joining through ScheduleEventLocation; `locations` below holds only
  // the ADDITIONAL locations beyond the primary. Nullable for backward
  // compatibility with rows created before the migration.
  locationId Int?
  location   Location? @relation("PrimaryLocation", fields: [locationId], references: [id])

  // The schedule term period (DateRangeDisplayText + From/To of the imported
  // file). Null for rows imported before this field existed — a re-import
  // fills it in.
  dateRangeId Int?
  dateRange   DateRange? @relation(fields: [dateRangeId], references: [id])

  // Lesson form parsed from the Subject tail (e.g. "…, лекция"). Null when
  // the subject carries no recognized form.
  lessonFormId Int?
  lessonForm   LessonForm? @relation(fields: [lessonFormId], references: [id])

  // Relations
  locations     ScheduleEventLocation[]
  groups        ScheduleEventGroup[]

  @@unique([educatorId, startDateTime, subjectId, globalEventHash])
  @@index([educatorId, startDateTime])
  @@index([startDateTime])
  @@index([endDateTime])
  @@index([subjectId])
  @@index([simultaneousGroupId])
  @@index([globalEventHash])
  @@index([lectureHash])
  @@index([kindCode])
  // Room analytics (workloads, KPI room count) group by this column.
  @@index([locationId])
  @@index([dateRangeId])
  @@index([lessonFormId])
}

model ScheduleEventLocation {
  eventId    String
  locationId Int
  event      ScheduleEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  location   Location      @relation(fields: [locationId], references: [id])

  // Holds only the ADDITIONAL locations of an event — the primary one is
  // denormalized into ScheduleEvent.locationId (see migration
  // scripts/migrate-primary-location.ts).

  @@id([eventId, locationId])
  @@index([locationId])
}

model ScheduleEventGroup {
  eventId String
  groupId Int
  event   ScheduleEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  group   Group         @relation(fields: [groupId], references: [id])

  @@id([eventId, groupId])
  @@index([groupId])
}
